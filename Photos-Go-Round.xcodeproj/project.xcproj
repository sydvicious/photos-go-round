{
  "default-configuration": "Release",
  "configurations": [
    { "name": "Claude", "file": "Config/Version.xcconfig" },
    { "name": "Debug", "file": "Config/Version.xcconfig" },
    { "name": "Release", "file": "Config/Version.xcconfig" },
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": ".",
    },
  ],
  "files": [
    {
      "kind": "group",
      "path": "Artwork",
      "children": [
        {
          "path": "PhotosGoRound.icon",
          "target-membership": [
            "Photos-Go-Round/resources",
            "Photos-Go-Round Widgets iOS/resources",
          ],
        },
        { "path": "Uninstaller.icon", "target-membership": [ "Photos-Go-Round Uninstaller/resources" ] },
      ],
    },
    { "kind": "folder", "path": "Audits" },
    {
      "kind": "group",
      "path": "Config",
      "children": [
        { "path": "Version.xcconfig" },
      ],
    },
    { "kind": "folder", "path": "Documentation" },
    {
      "kind": "group",
      "path": "MacOS",
      "children": [
        {
          "kind": "group",
          "path": "Agent",
          "children": [
            {
              "kind": "group",
              "path": "Dashboard",
              "children": [
                { "kind": "folder", "path": "Resources", "target-membership": [ "Photos-Go-Round Server" ] },
                { "kind": "folder", "path": "Sources", "target-membership": [ "Photos-Go-Round Server" ] },
                { "kind": "folder", "path": "Tests" },
              ],
            }, {
              "kind": "group",
              "path": "Endpoints",
              "children": [
                { "kind": "folder", "path": "Sources", "target-membership": [ "Photos-Go-Round Server" ] },
                { "kind": "folder", "path": "Tests" },
              ],
            },
            { "kind": "folder", "path": "Resources" },
            { "kind": "folder", "path": "Sources", "target-membership": [ "Photos-Go-Round Server" ] },
            { "kind": "folder", "path": "Tests" },
          ],
        }, {
          "kind": "group",
          "path": "Desktop",
          "children": [
            { "path": "FEATURES.md" },
            { "kind": "folder", "path": "Sources", "target-membership": [ "Photos-Go-Round" ] },
            { "kind": "folder", "path": "Tests", "target-membership": [ "Photos-Go-RoundTests" ] },
          ],
        }, {
          "kind": "group",
          "path": "Screensaver",
          "children": [
            { "kind": "folder", "path": "Resources" },
            { "kind": "folder", "path": "Sources", "target-membership": [ "Photos-Go-Round Saver" ] },
          ],
        },
        { "kind": "folder", "path": "Shared" },
        {
          "kind": "group",
          "path": "Tools",
          "children": [
            {
              "kind": "group",
              "path": "pgr_ctl",
              "children": [
                { "kind": "folder", "path": "Sources", "target-membership": [ "pgr_ctl" ] },
                { "kind": "folder", "path": "Tests" },
              ],
            }, {
              "kind": "group",
              "path": "pgr_install",
              "children": [
                { "kind": "folder", "path": "Sources", "target-membership": [ "pgr_install" ] },
              ],
            },
          ],
        }, {
          "kind": "group",
          "path": "Uninstaller",
          "children": [
            { "kind": "folder", "path": "Sources", "target-membership": [ "Photos-Go-Round Uninstaller" ] },
          ],
        }, {
          "kind": "group",
          "path": "Wallpaper",
          "children": [
            { "kind": "folder", "path": "Resources" },
            {
              "kind": "folder",
              "path": "Sources",
              "target-membership": [
                "Photos-Go-Round Wallpaper",
                "Photos-Go-Round Wallpaper Host",
              ],
              "membership-exceptions": [
                {
                  "target": "Photos-Go-Round Wallpaper",
                  "exclusions": [
                    "Host.swift",
                  ],
                }, {
                  "target": "Photos-Go-Round Wallpaper Host",
                  "exclusions": [
                    "AgentPicture.swift",
                    "Extension.swift",
                    "Identity.swift",
                    "LastPicture.swift",
                    "PaneHandler.swift",
                    "PaneModels.swift",
                    "PaneThumbnail.swift",
                    "Rotation.swift",
                  ],
                },
              ],
            },
          ],
        },
      ],
    },
    { "kind": "folder", "path": "Plans" },
    { "kind": "folder", "path": "Scripts" },
    { "kind": "folder", "path": "Shared" },
    {
      "kind": "group",
      "path": "Widgets",
      "children": [
        {
          "kind": "group",
          "path": "iOS",
          "children": [
            {
              "kind": "group",
              "path": "App",
              "children": [
                { "kind": "folder", "path": "Resources" },
                { "kind": "folder", "path": "Sources", "target-membership": [ "Photos-Go-Round Widgets iOS" ] },
              ],
            }, {
              "kind": "group",
              "path": "Extension",
              "children": [
                { "kind": "folder", "path": "Resources" },
                { "kind": "folder", "path": "Sources", "target-membership": [ "Photos-Go-Round Widgets iOS Extension" ] },
              ],
            },
          ],
        }, {
          "kind": "group",
          "path": "macOS",
          "children": [
            { "kind": "folder", "path": "Resources" },
            { "kind": "folder", "path": "Sources", "target-membership": [ "Photos-Go-Round Widget" ] },
          ],
        },
        { "kind": "folder", "path": "Shared" },
      ],
    },
    { "path": "CLAUDE.md" },
    { "path": "LICENSE" },
    { "path": "Package Tests.xctestplan" },
    { "path": "Package.swift" },
    { "path": "README.md" },
    { "path": "TODO.md" },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Photos-Go-Round.app", "id": "000000000000000000000120", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/Photos-Go-RoundTests.xctest", "id": "AA0000000000000000000060", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/Photos-Go-Round Screensaver (Debug).saver", "id": "AA00000000000000000000A1", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/Photos-Go-Round Server.app", "id": "AA00000000000000000000C1", "type": "wrapper.application", "index": false, "target-membership": [ { "build-phase": "Photos-Go-Round/copy/Embed Agent", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/pgr_ctl", "id": "AA00000000000000000000D1", "type": "compiled.mach-o.executable", "index": false },
        { "path": "<PRODUCTS>/pgr_install", "id": "AA0000000000000000000301", "type": "compiled.mach-o.executable", "index": false },
        { "path": "<PRODUCTS>/Photos-Go-Round Wallpaper.appex", "id": "AA00000000000000000000E1", "type": "wrapper.extensionkit-extension", "index": false, "target-membership": [ { "build-phase": "Photos-Go-Round Wallpaper Host/copy/Embed ExtensionKit Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/Photos-Go-Round Wallpaper Host.app", "id": "AA00000000000000000000F1", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/Photos-Go-Round Screensaver$(SAVER_NAME_SUFFIX).saver", "type": "wrapper.cfbundle", "index": false, "target-membership": [ { "build-phase": "Photos-Go-Round/copy/Embed Screensaver", "code-sign-on-copy": true } ] },
        { "path": "<PRODUCTS>/Photos-Go-Round Wallpaper.appex", "type": "wrapper.cfbundle", "index": false, "target-membership": [ { "build-phase": "Photos-Go-Round/copy/Embed Wallpaper Extension", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/Uninstall Photos-Go-Round.app", "id": "AA0000000000000000000921", "type": "wrapper.application", "index": false, "target-membership": [ { "build-phase": "Photos-Go-Round/copy/Embed Uninstaller", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/Photos-Go-Round Widget.appex", "id": "AA0000000000000000000B01", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Photos-Go-Round/copy/Embed Widget Extension", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/Photos-Go-Round Widgets.app", "id": "AA0000000000000000000C01", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/Photos-Go-Round Widgets Extension.appex", "id": "AA0000000000000000000D01", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Photos-Go-Round Widgets iOS/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "pgr_ctl",
      "id": "AA00000000000000000000D0",
      "product": "Products/pgr_ctl",
      "product-type": "tool",
      "build-phases": [
        "compile-sources",
        "frameworks",
      ],
      "package-product-members": [
        {
          "product-name": "Console",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "PhotosGoRoundAgentAPI",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "PhotosGoRoundDisplay",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "PhotosGoRoundKit",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "CODE_SIGN_STYLE": "Automatic",
        "CREATE_INFOPLIST_SECTION_IN_BINARY": "YES",
        "ENABLE_APP_SANDBOX": "NO",
        "GENERATE_INFOPLIST_FILE": "NO",
        "INFOPLIST_FILE": "MacOS/Tools/pgr_ctl/Sources/Info.plist",
        "MACOSX_DEPLOYMENT_TARGET": "27.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.sydpolk.photosgoround.pgr-ctl$(STORAGE_ID_SUFFIX)",
        "PRODUCT_NAME": "pgr_ctl",
        "SDKROOT": "auto",
        "SUPPORTED_PLATFORMS": "macosx",
        "SWIFT_EMIT_LOC_STRINGS": "NO",
        "SWIFT_VERSION": "6.0",
      },
    }, {
      "name": "pgr_install",
      "id": "AA0000000000000000000300",
      "product": "Products/pgr_install",
      "product-type": "tool",
      "build-phases": [
        "compile-sources",
        "frameworks",
      ],
      "package-product-members": [
        {
          "product-name": "Console",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "PhotosGoRoundAgentAPI",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "PhotosGoRoundInstall",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "CODE_SIGN_STYLE": "Automatic",
        "ENABLE_APP_SANDBOX": "NO",
        "MACOSX_DEPLOYMENT_TARGET": "27.0",
        "PRODUCT_NAME": "pgr_install",
        "SDKROOT": "auto",
        "SUPPORTED_PLATFORMS": "macosx",
        "SWIFT_EMIT_LOC_STRINGS": "NO",
        "SWIFT_VERSION": "6.0",
      },
    }, {
      "name": "Photos-Go-Round",
      "id": "000000000000000100000000",
      "product": "Products/Photos-Go-Round.app",
      "product-type": "application",
      "dependencies": [
        "Photos-Go-Round Server",
        "Photos-Go-Round Wallpaper",
        "Photos-Go-Round Widget",
        "Photos-Go-Round Saver",
        "Photos-Go-Round Uninstaller",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Agent",
          "bundle-base-path": "contents-directory",
          "relative-path": "Helpers",
        }, {
          "kind": "copy",
          "name": "Embed Wallpaper Extension",
          "bundle-base-path": "contents-directory",
          "relative-path": "Library/Wallpaper",
        }, {
          "kind": "copy",
          "name": "Embed Widget Extension",
          "bundle-base-path": "contents-directory",
          "relative-path": "PlugIns",
        }, {
          "kind": "copy",
          "name": "Embed Screensaver",
          "bundle-base-path": "resources-directory",
        }, {
          "kind": "copy",
          "name": "Embed Uninstaller",
          "bundle-base-path": "contents-directory",
          "relative-path": "Helpers",
        }, {
          "kind": "script",
          "name": "Record Git Commit",
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "# The git commit this build came from, for the About box with Option held.",
            "# Every configuration, so any variant says which commit it is. Written into the",
            "# built Info.plist after Xcode has processed it and before it is signed.",
            "# Plans/Release DMG.md.",
            "commit=\"$(/usr/bin/git -C \"$SRCROOT\" describe --always --dirty --abbrev=10 2>/dev/null || echo unknown)\"",
            "plist=\"$TARGET_BUILD_DIR/$INFOPLIST_PATH\"",
            "/usr/libexec/PlistBuddy -c \"Delete :PGRGitCommit\" \"$plist\" 2>/dev/null || true",
            "/usr/libexec/PlistBuddy -c \"Add :PGRGitCommit string $commit\" \"$plist\"",
            "",
          ],
        },
      ],
      "package-product-members": [
        {
          "product-name": "PhotosGoRoundAgentAPI",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "PhotosGoRoundDisplay",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "PhotosGoRoundInstall",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "PhotosGoRoundWidgetFace",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "PhotosGoRoundWidgetSettings",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "TinyCache",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "PhotosGoRound",
        "CODE_SIGN_ENTITLEMENTS": "MacOS/Desktop/Resources/Photos-Go-Round.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "ENABLE_APP_SANDBOX": "NO",
        "ENABLE_PREVIEWS": "YES",
        "ENABLE_USER_SCRIPT_SANDBOXING": "NO",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_KEY_CFBundleDisplayName": "Photos-Go-Round",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.entertainment",
        "INFOPLIST_KEY_NSPhotoLibraryUsageDescription": "Photos-Go-Round reads your photo library so it can shuffle your photos onto your desktop and screensaver. Nothing is ever uploaded or shared.",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_UIStatusBarStyle[sdk=iphoneos*]": "UIStatusBarStyleDefault",
        "INFOPLIST_KEY_UIStatusBarStyle[sdk=iphonesimulator*]": "UIStatusBarStyleDefault",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone": "UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "LD_RUNPATH_SEARCH_PATHS": "@executable_path/Frameworks",
        "LD_RUNPATH_SEARCH_PATHS[sdk=macosx*]": "@executable_path/../Frameworks",
        "MACOSX_DEPLOYMENT_TARGET": "27.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.sydpolk.photosgoround$(STORAGE_ID_SUFFIX)",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "REGISTER_APP_GROUPS": "YES",
        "SDKROOT": "auto",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SUPPORTED_PLATFORMS": "macosx",
        "SUPPORTS_MACCATALYST": "NO",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_UPCOMING_FEATURE_NONISOLATED_NONSENDING_BY_DEFAULT": "YES",
        "SWIFT_VERSION": "6.0",
      },
    }, {
