    }, {
      "name": "Release DMG",
      "id": "AA0000000000000000000940",
      "kind": "aggregate",
      "build-phases": [
        {
          "kind": "script",
          "name": "Make the Release DMG",
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "# Builds, signs and notarizes a Release, and packages it in its disk image:",
            "# Scripts/release-build.sh. So building this target is making a release, and it",
            "# is Syd's to build — it uploads to Apple's notary service. Plans/Release DMG.md.",
            "#",
            "# The environment is cleared first. This build's own settings — SDKROOT,",
            "# CONFIGURATION and the rest — would otherwise reach the archive the script runs.",
            "# The script's last line is the image; Finder then shows it. Syd, 2026-09-27:",
            "# \"it would be great if the build target would open the enclosing folder.\"",
            "set -eo pipefail",
            "DMG=\"$(/usr/bin/env -i HOME=\"$HOME\" USER=\"$USER\" LOGNAME=\"$LOGNAME\" TMPDIR=\"$TMPDIR\" \\",
            "    PATH=\"/usr/bin:/bin:/usr/sbin:/sbin\" \"$SRCROOT/Scripts/release-build.sh\" | tee /dev/stderr | tail -n 1)\"",
            "/usr/bin/open -R \"$DMG\"",
            "",
          ],
        },
      ],
      "build-settings": {
        "ENABLE_USER_SCRIPT_SANDBOXING": "NO",
        "PRODUCT_NAME": "$(TARGET_NAME)",
      },
    }, {
